# ---------------------------------------------------------------------------
# Browser (VITE_ prefix = bundled into the frontend, so public values only)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional: call a deployed faq-ai function even during `npm run dev`
# VITE_FAQ_AI_URL=https://your-project.supabase.co/functions/v1/faq-ai

# ---------------------------------------------------------------------------
# Server only (read by the Vite dev server and the faq-ai Edge Function).
# Never add a VITE_ prefix to these.
# ---------------------------------------------------------------------------
# gemini | openrouter
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: NVIDIA Nemotron models via OpenRouter (https://openrouter.ai/keys)
# Selectable from the app's AI settings once the key is set.
# OPENROUTER_API_KEY=your_openrouter_key_here
# Default OpenRouter model: nvidia/nemotron-3-super-120b-a12b:free or nvidia/nemotron-3-ultra-550b-a55b
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# AI_FALLBACK_PROVIDER=openrouter

# Optional: let models that support it think before answering (slower): low | medium | high
# AI_REASONING_EFFORT=low

# Optional tuning: above FAQ_FULL_CONTEXT_LIMIT FAQs, pgvector pre-filters
# down to FAQ_PREFILTER_COUNT before the AI reads them
# FAQ_FULL_CONTEXT_LIMIT=300
# FAQ_PREFILTER_COUNT=80
